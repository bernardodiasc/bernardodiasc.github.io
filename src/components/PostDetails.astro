---
import PostHeader from './PostHeader.astro';
import TextBlock from './TextBlock.astro';
import SeriesList from './SeriesList.astro';
import Share from './Share.astro';

interface Props {
  id: string;
  title: string;
  date: Date;
  category?: {
    id: string;
    title: string;
    icon: string;
  };
  tags?: string[];
  url: string;
  series?: string;
  lang?: 'en' | 'pt';
}

const {
  id,
  title,
  date,
  category,
  tags = [],
  url,
  series = '',
  lang = 'en',
} = Astro.props;
---

<div class="post-details">
  <PostHeader
    mode="details"
    title={title}
    date={date}
    category={category}
    tags={tags}
  />
  <TextBlock>
    {series && (
      <SeriesList currentPostId={id} seriesName={series} lang={lang} />
    )}
    <slot />
  </TextBlock>
</div>

<style>
  .post-details {
    font-size: var(--text-size);
    padding: 2em 1em 4em;
  }

  @media only screen and (min-width: 1024px) {
    .post-details {
      padding: 2em 2em 4em;
    }
  }
</style>
